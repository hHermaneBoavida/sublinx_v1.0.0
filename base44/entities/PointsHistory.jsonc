{
  "name": "PointsHistory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "event_attendance",
        "photo_share",
        "video_share",
        "event_checkin",
        "review_write",
        "referral"
      ],
      "description": "Tipo de a\u00e7\u00e3o que gerou os pontos"
    },
    "points": {
      "type": "number",
      "description": "Quantidade de pontos ganhos"
    },
    "event_id": {
      "type": "string",
      "description": "ID do evento relacionado (se aplic\u00e1vel)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da a\u00e7\u00e3o"
    }
  },
  "required": [
    "user_id",
    "action_type",
    "points",
    "description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
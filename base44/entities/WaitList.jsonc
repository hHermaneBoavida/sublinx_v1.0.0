{
  "name": "WaitList",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email do solicitante"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo"
    },
    "city": {
      "type": "string",
      "description": "Cidade do solicitante"
    },
    "favorite_genre": {
      "type": "string",
      "description": "G\u00eanero musical favorito"
    },
    "why_join": {
      "type": "string",
      "description": "Motiva\u00e7\u00e3o para entrar"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "invited",
        "rejected"
      ],
      "default": "pending",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de submiss\u00e3o"
    },
    "invite_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data do convite"
    },
    "invite_code": {
      "type": "string",
      "description": "C\u00f3digo de convite \u00fanico"
    }
  },
  "required": [
    "email",
    "full_name",
    "city"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
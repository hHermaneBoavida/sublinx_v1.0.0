{
  "name": "SignalView",
  "type": "object",
  "properties": {
    "signal_id": {
      "type": "string",
      "description": "ID do alerta visualizado"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que visualizou"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento da visualiza\u00e7\u00e3o confirmada pelo servidor"
    }
  },
  "required": [
    "signal_id",
    "user_id",
    "viewed_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
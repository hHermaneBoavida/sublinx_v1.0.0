{
  "name": "TicketType",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "name": {
      "type": "string",
      "description": "Nome do tipo de ingresso"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o do ingresso"
    },
    "quantity_available": {
      "type": "number",
      "description": "Quantidade dispon\u00edvel"
    },
    "quantity_sold": {
      "type": "number",
      "default": 0,
      "description": "Quantidade vendida"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do ingresso"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Benef\u00edcios inclu\u00eddos"
    },
    "sale_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de in\u00edcio das vendas"
    },
    "sale_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de fim das vendas"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o tipo est\u00e1 ativo"
    }
  },
  "required": [
    "event_id",
    "name",
    "price",
    "quantity_available"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.event_id": {
            "$in": [
              "{{user.organized_event_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "data.is_active": true
    },
    "update": {
      "$or": [
        {
          "data.event_id": {
            "$in": [
              "{{user.organized_event_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.event_id": {
            "$in": [
              "{{user.organized_event_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
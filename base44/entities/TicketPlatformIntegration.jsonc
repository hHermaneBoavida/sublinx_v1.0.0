{
  "name": "TicketPlatformIntegration",
  "type": "object",
  "properties": {
    "organizer_id": {
      "type": "string",
      "description": "ID do organizador"
    },
    "platform": {
      "type": "string",
      "enum": [
        "eventbrite",
        "ticketmaster",
        "sympla",
        "shotgun",
        "custom"
      ],
      "description": "Plataforma de ingressos"
    },
    "api_key": {
      "type": "string",
      "description": "Chave da API (criptografada)"
    },
    "api_secret": {
      "type": "string",
      "description": "Secret da API (criptografado)"
    },
    "webhook_url": {
      "type": "string",
      "description": "URL do webhook para receber atualiza\u00e7\u00f5es"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a integra\u00e7\u00e3o est\u00e1 ativa"
    },
    "last_sync": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima sincroniza\u00e7\u00e3o"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "pending"
      ],
      "default": "pending",
      "description": "Status da \u00faltima sincroniza\u00e7\u00e3o"
    },
    "sync_error": {
      "type": "string",
      "description": "Mensagem de erro se houver"
    },
    "auto_sync": {
      "type": "boolean",
      "default": true,
      "description": "Sincroniza\u00e7\u00e3o autom\u00e1tica habilitada"
    },
    "sync_interval": {
      "type": "number",
      "default": 300,
      "description": "Intervalo de sincroniza\u00e7\u00e3o em segundos"
    }
  },
  "required": [
    "organizer_id",
    "platform"
  ],
  "rls": {
    "create": {
      "data.organizer_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
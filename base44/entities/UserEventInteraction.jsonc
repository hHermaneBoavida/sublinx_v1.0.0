{
  "name": "UserEventInteraction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio"
    },
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "interaction_type": {
      "type": "string",
      "enum": [
        "like",
        "checkin",
        "interested",
        "going",
        "comment"
      ],
      "description": "Tipo de intera\u00e7\u00e3o"
    },
    "comment_text": {
      "type": "string",
      "description": "Texto do coment\u00e1rio se aplic\u00e1vel"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Avalia\u00e7\u00e3o do evento (1-5)"
    }
  },
  "required": [
    "user_id",
    "event_id",
    "interaction_type"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
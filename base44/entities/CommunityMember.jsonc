{
  "name": "CommunityMember",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string",
      "description": "ID da comunidade"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio"
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "moderator",
        "admin"
      ],
      "default": "member",
      "description": "Papel na comunidade"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de entrada"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se \u00e9 um membro ativo"
    }
  },
  "required": [
    "community_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
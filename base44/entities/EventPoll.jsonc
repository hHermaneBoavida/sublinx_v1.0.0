{
  "name": "EventPoll",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "organizer_id": {
      "type": "string",
      "description": "ID do organizador"
    },
    "question": {
      "type": "string",
      "description": "Pergunta da vota\u00e7\u00e3o"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "votes": {
            "type": "number",
            "default": 0
          }
        }
      },
      "description": "Op\u00e7\u00f5es da vota\u00e7\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 ativa"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando a vota\u00e7\u00e3o termina"
    },
    "votes_count": {
      "type": "number",
      "default": 0,
      "description": "Total de votos"
    },
    "allow_multiple": {
      "type": "boolean",
      "default": false,
      "description": "Permitir m\u00faltiplas escolhas"
    }
  },
  "required": [
    "event_id",
    "organizer_id",
    "question",
    "options"
  ],
  "rls": {
    "create": {
      "data.organizer_id": "{{user.id}}"
    },
    "read": {
      "data.is_active": true
    },
    "update": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
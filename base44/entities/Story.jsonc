{
  "name": "Story",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que postou o story"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio para exibi\u00e7\u00e3o r\u00e1pida"
    },
    "user_avatar_url": {
      "type": "string",
      "description": "URL do avatar do usu\u00e1rio"
    },
    "media_url": {
      "type": "string",
      "description": "URL da imagem ou v\u00eddeo"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "video"
    },
    "duration": {
      "type": "number",
      "default": 15,
      "description": "Dura\u00e7\u00e3o em segundos"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora em que o story expira"
    },
    "event_id": {
      "type": "string",
      "description": "ID do evento relacionado (opcional)"
    }
  },
  "required": [
    "user_id",
    "user_name",
    "user_avatar_url",
    "media_url",
    "expires_at"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
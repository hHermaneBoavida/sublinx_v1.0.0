{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "chat_id": {
      "type": "string",
      "description": "ID do chat/conversa"
    },
    "sender_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que enviou"
    },
    "sender_name": {
      "type": "string",
      "description": "Nome do remetente"
    },
    "message": {
      "type": "string",
      "description": "Conte\u00fado da mensagem"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "audio",
        "file"
      ],
      "default": "text",
      "description": "Tipo da mensagem"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo se aplic\u00e1vel"
    },
    "is_edited": {
      "type": "boolean",
      "default": false,
      "description": "Se a mensagem foi editada"
    },
    "reply_to": {
      "type": "string",
      "description": "ID da mensagem que est\u00e1 respondendo"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Se a mensagem est\u00e1 fixada"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Se foi deletada pelo moderador"
    }
  },
  "required": [
    "chat_id",
    "sender_id",
    "sender_name",
    "message"
  ],
  "rls": {
    "create": {
      "data.sender_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.chat_id": {
            "$exists": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
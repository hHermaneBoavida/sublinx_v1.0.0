{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nome do evento"
    },
    "subtitle": {
      "type": "string",
      "description": "Subt\u00edtulo do evento"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o completa do evento"
    },
    "short_description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o curta para previews"
    },
    "genre": {
      "type": "string",
      "enum": [
        "techno",
        "house",
        "trance",
        "drum_bass",
        "dubstep",
        "ambient",
        "experimental",
        "acid",
        "minimal",
        "hardcore",
        "funk",
        "trap",
        "kuduro",
        "kizomba",
        "samba",
        "pagode",
        "rap",
        "hip_hop",
        "reggae"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "musica",
        "festa",
        "festival",
        "show",
        "workshop",
        "exposicao",
        "esporte",
        "gastronomia",
        "tecnologia",
        "negocios",
        "cultural",
        "social",
        "outro"
      ],
      "description": "Categoria ampla do evento (agregador global)"
    },
    "subcategory": {
      "type": "string",
      "description": "Subcategoria do evento"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags do evento"
    },
    "type": {
      "type": "string",
      "enum": [
        "rave",
        "warehouse",
        "rooftop",
        "underground",
        "festival",
        "club",
        "secret",
        "concert",
        "show",
        "workshop",
        "conference",
        "exhibition",
        "party",
        "sport_event",
        "cultural_event",
        "networking",
        "other"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "address": {
          "type": "string"
        },
        "venue_name": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "description": "Pa\u00eds (ISO 3166)"
        },
        "is_secret": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de t\u00e9rmino (para eventos de m\u00faltiplos dias)"
    },
    "timezone": {
      "type": "string",
      "description": "Fuso hor\u00e1rio (ex: America/Sao_Paulo)"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence_pattern": {
      "type": "string",
      "description": "Padr\u00e3o de recorr\u00eancia (RRULE ou texto)"
    },
    "duration_hours": {
      "type": "number"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o base (usado para exibi\u00e7\u00e3o r\u00e1pida)"
    },
    "is_free": {
      "type": "boolean",
      "default": false
    },
    "min_price": {
      "type": "number",
      "description": "Menor pre\u00e7o de ingresso"
    },
    "max_price": {
      "type": "number",
      "description": "Maior pre\u00e7o de ingresso"
    },
    "currency": {
      "type": "string",
      "description": "Moeda (ISO 4217, ex: BRL, USD)"
    },
    "ticket_url": {
      "type": "string",
      "description": "Link para compra de ingressos"
    },
    "is_secret": {
      "type": "boolean",
      "default": false
    },
    "organizer": {
      "type": "string",
      "description": "Nome do organizador (cache)"
    },
    "organizer_id": {
      "type": "string",
      "description": "ID do organizador (User ou ExternalOrganizer)"
    },
    "organizer_logo": {
      "type": "string"
    },
    "organizer_website": {
      "type": "string"
    },
    "organizer_instagram": {
      "type": "string"
    },
    "organizer_facebook": {
      "type": "string"
    },
    "organizer_tiktok": {
      "type": "string"
    },
    "organizer_linkedin": {
      "type": "string"
    },
    "organizer_email": {
      "type": "string"
    },
    "organizer_phone": {
      "type": "string"
    },
    "max_capacity": {
      "type": "number"
    },
    "current_attendees": {
      "type": "number",
      "default": 0
    },
    "image_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail do evento"
    },
    "gallery_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Galeria de imagens"
    },
    "video_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "V\u00eddeos do evento"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo do evento"
    },
    "requires_approval": {
      "type": "boolean",
      "default": true
    },
    "minimum_level": {
      "type": "number",
      "default": 1
    },
    "age_restriction": {
      "type": "string",
      "enum": [
        "all",
        "16+",
        "18+",
        "21+"
      ],
      "default": "18+"
    },
    "refund_policy": {
      "type": "string",
      "enum": [
        "flexible",
        "moderate",
        "strict"
      ],
      "default": "flexible"
    },
    "allow_waitlist": {
      "type": "boolean",
      "default": true
    },
    "event_status": {
      "type": "string",
      "enum": [
        "published",
        "cancelled",
        "postponed",
        "sold_out",
        "ended"
      ],
      "default": "published",
      "description": "Status do evento"
    },
    "trust_level": {
      "type": "string",
      "enum": [
        "verified",
        "confirmed",
        "partner",
        "pending",
        "rejected"
      ],
      "default": "pending",
      "description": "N\u00edvel de confian\u00e7a: verified=N\u00edvel1 (fonte oficial), confirmed=N\u00edvel2 (estabelecimento), partner=N\u00edvel3 (parceiro SUBLINX), pending=N\u00edvel4 (aguardando), rejected=reprovado"
    },
    "source": {
      "type": "string",
      "enum": [
        "organizer",
        "google_places",
        "google_business",
        "facebook",
        "instagram",
        "official_site",
        "sublinx_partner",
        "admin",
        "serpapi",
        "ticketmaster",
        "eventbrite",
        "meetup",
        "bandsintown",
        "sympla",
        "shotgun",
        "ingresse",
        "google_geocoding",
        "google_events"
      ],
      "description": "Origem verific\u00e1vel do evento"
    },
    "source_url": {
      "type": "string",
      "description": "URL de origem do evento (link verific\u00e1vel)"
    },
    "source_id": {
      "type": "string",
      "description": "ID externo do evento na fonte de origem"
    },
    "slug": {
      "type": "string",
      "description": "Slug URL-friendly do evento"
    },
    "sync_hash": {
      "type": "string",
      "description": "Hash para deduplica\u00e7\u00e3o (t\u00edtulo normalizado + data + cidade)"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima sincroniza\u00e7\u00e3o com a fonte"
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "description": "Evento vis\u00edvel publicamente. Somente trust_level verified/confirmed/partner pode ser true."
    },
    "is_expired": {
      "type": "boolean",
      "default": false,
      "description": "Evento com data passada (marcado automaticamente)"
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de erros de valida\u00e7\u00e3o que impedem a publica\u00e7\u00e3o"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o evento foi verificado"
    },
    "verified_by": {
      "type": "string",
      "description": "ID do admin/sistema que verificou"
    },
    "last_validated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que os dados foram validados"
    }
  },
  "required": [
    "title",
    "genre",
    "type",
    "location",
    "date",
    "organizer_id",
    "source",
    "trust_level"
  ],
  "rls": {
    "create": {
      "data.organizer_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.is_published": true,
          "data.trust_level": {
            "$in": [
              "verified",
              "confirmed",
              "partner"
            ]
          },
          "data.is_secret": false
        },
        {
          "data.is_secret": true,
          "user_condition": {
            "is_pro_member": true
          }
        },
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organizer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
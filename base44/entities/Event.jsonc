{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nome do evento"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do evento"
    },
    "genre": {
      "type": "string",
      "enum": [
        "techno",
        "house",
        "trance",
        "drum_bass",
        "dubstep",
        "ambient",
        "experimental",
        "acid",
        "minimal",
        "hardcore",
        "funk",
        "trap",
        "kuduro",
        "kizomba",
        "samba",
        "pagode",
        "rap",
        "hip_hop",
        "reggae"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "rave",
        "warehouse",
        "rooftop",
        "underground",
        "festival",
        "club",
        "secret"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "address": {
          "type": "string"
        },
        "venue_name": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "is_secret": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "duration_hours": {
      "type": "number"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o base (usado para exibi\u00e7\u00e3o r\u00e1pida)"
    },
    "is_secret": {
      "type": "boolean",
      "default": false
    },
    "organizer": {
      "type": "string",
      "description": "Nome do organizador (cache)"
    },
    "organizer_id": {
      "type": "string",
      "description": "ID do organizador"
    },
    "max_capacity": {
      "type": "number"
    },
    "current_attendees": {
      "type": "number",
      "default": 0
    },
    "image_url": {
      "type": "string"
    },
    "requires_approval": {
      "type": "boolean",
      "default": true
    },
    "minimum_level": {
      "type": "number",
      "default": 1
    },
    "age_restriction": {
      "type": "string",
      "enum": [
        "all",
        "16+",
        "18+",
        "21+"
      ],
      "default": "18+"
    },
    "refund_policy": {
      "type": "string",
      "enum": [
        "flexible",
        "moderate",
        "strict"
      ],
      "default": "flexible"
    },
    "allow_waitlist": {
      "type": "boolean",
      "default": true
    },
    "trust_level": {
      "type": "string",
      "enum": [
        "verified",
        "confirmed",
        "partner",
        "pending",
        "rejected"
      ],
      "default": "pending",
      "description": "N\u00edvel de confian\u00e7a: verified=N\u00edvel1 (fonte oficial), confirmed=N\u00edvel2 (estabelecimento), partner=N\u00edvel3 (parceiro SUBLINX), pending=N\u00edvel4 (aguardando), rejected=reprovado"
    },
    "source": {
      "type": "string",
      "enum": [
        "organizer",
        "google_places",
        "google_business",
        "facebook",
        "instagram",
        "official_site",
        "sublinx_partner",
        "admin"
      ],
      "description": "Origem verific\u00e1vel do evento"
    },
    "source_url": {
      "type": "string",
      "description": "URL de origem do evento (link verific\u00e1vel)"
    },
    "source_id": {
      "type": "string",
      "description": "ID externo do evento na fonte de origem"
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "description": "Evento vis\u00edvel publicamente. Somente trust_level verified/confirmed/partner pode ser true."
    },
    "is_expired": {
      "type": "boolean",
      "default": false,
      "description": "Evento com data passada (marcado automaticamente)"
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de erros de valida\u00e7\u00e3o que impedem a publica\u00e7\u00e3o"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o evento foi verificado"
    },
    "verified_by": {
      "type": "string",
      "description": "ID do admin/sistema que verificou"
    },
    "last_validated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que os dados foram validados"
    }
  },
  "required": [
    "title",
    "genre",
    "type",
    "location",
    "date",
    "organizer_id",
    "source",
    "trust_level"
  ]
}
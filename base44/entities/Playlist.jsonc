{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "name": {
      "type": "string",
      "description": "Nome da playlist"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da playlist"
    },
    "creator_id": {
      "type": "string",
      "description": "ID do criador"
    },
    "is_collaborative": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 colaborativa"
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "duration": {
            "type": "number"
          },
          "added_by": {
            "type": "string"
          },
          "added_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "M\u00fasicas da playlist"
    },
    "followers": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de seguidores"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "Se \u00e9 p\u00fablica"
    }
  },
  "required": [
    "event_id",
    "name",
    "creator_id"
  ]
}
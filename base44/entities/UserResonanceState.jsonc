{
  "name": "UserResonanceState",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio"
    },
    "state_vector": {
      "type": "object",
      "description": "Vetor multidimensional de resson\u00e2ncia",
      "properties": {
        "temporal_patterns": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "content_affinity": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "interaction_depth": {
          "type": "number"
        },
        "recurrence_score": {
          "type": "number"
        },
        "silent_consumption_ratio": {
          "type": "number"
        }
      }
    },
    "confidence_level": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confian\u00e7a do modelo (aumenta com tempo)"
    },
    "last_computed": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima computa\u00e7\u00e3o do estado"
    },
    "signal_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de sinais processados"
    },
    "maturity_level": {
      "type": "string",
      "enum": [
        "nascent",
        "developing",
        "established",
        "mature"
      ],
      "default": "nascent",
      "description": "Maturidade do estado"
    }
  },
  "required": [
    "user_id",
    "state_vector",
    "confidence_level"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Comment",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que comentou"
    },
    "event_id": {
      "type": "string",
      "description": "ID do evento comentado"
    },
    "content": {
      "type": "string",
      "description": "Conte\u00fado do coment\u00e1rio"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio (para exibi\u00e7\u00e3o)"
    }
  },
  "required": [
    "user_id",
    "event_id",
    "content",
    "user_name"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
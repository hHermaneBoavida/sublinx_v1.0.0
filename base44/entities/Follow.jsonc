{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que est\u00e1 seguindo"
    },
    "following_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio sendo seguido"
    },
    "followed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data que come\u00e7ou a seguir"
    }
  },
  "required": [
    "follower_id",
    "following_id"
  ],
  "rls": {
    "create": {
      "data.follower_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "data.following_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
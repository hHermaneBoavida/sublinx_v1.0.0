{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_full_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "full_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncExternalEvents",
            "args": {
              "action": "sync",
              "sync_type": "full"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sincroniza\u00e7\u00e3o completa di\u00e1ria",
            "description": "Importa eventos de todas as cidades"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Importa\u00e7\u00e3o completa de eventos de todas as cidades e categorias \u2014 executa uma vez por dia",
  "name": "Sincroniza\u00e7\u00e3o Di\u00e1ria Completa"
}
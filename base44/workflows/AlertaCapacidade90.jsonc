      }
    ]
  },
  "name": "Alerta de Capacidade 90%",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "A cada hora verifica a ocupa\u00e7\u00e3o dos eventos (ingressos vendidos + convidados confirmados da lista) e avisa o organizador quando atinge 90% da capacidade."

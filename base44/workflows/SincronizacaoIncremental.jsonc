{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "incremental_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "incremental_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncExternalEvents",
            "args": {
              "action": "sync",
              "sync_type": "incremental"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sincroniza\u00e7\u00e3o incremental",
            "description": "A cada 30 minutos"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Atualiza\u00e7\u00e3o incremental de eventos a cada 30 minutos \u2014 detecta altera\u00e7\u00f5es, cancelamentos e novos eventos",
  "name": "Sincroniza\u00e7\u00e3o Incremental"
}